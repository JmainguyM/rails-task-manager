<h1>coucou!</h1>
<ul class="check-list">
  <% @tasks.each do |task| %>
    <li>
       <%= link_to task_path(task) do %>
          <i class="<%= task.completed ? 'fa-solid fa-square-check' : 'fa-regular fa-square' %>"></i>
          <%= task.title %>
        <% end %>
    </li>
  <%end %>
</ul>

<p><%= link_to "create", new_task_path %></p>

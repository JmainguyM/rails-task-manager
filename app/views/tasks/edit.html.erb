<h1>coucou</h1>

<h2>Que voulez vous éditer dans votre tâche?</h2>
<%= form_with model: @task do |f| %>
  <%= f.label :title %>
  <%= f.text_field :title %>
  <%= f.label :details %>
  <%= f.text_field :details %>
  <%= f.label :completed, "Terminée ?" %>
  <%= f.check_box :completed %>
  <%= f.submit %>
<% end %>

<%= link_to "annuler", task_path(@task) %>

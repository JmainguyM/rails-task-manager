<h1>coucou</h1>

<h2>Quel tâche voulez vous ajouter?</h2>
<%= form_with model: @task do |f| %>
  <%= f.label :title %>
  <%= f.text_field :title %>
  <%= f.label :details %>
  <%= f.text_field :details %>
  <%= f.submit %>

  <% if @task.errors.any? %>
    <div class="alert alert-warning" role="alert">
      <ul>
        <% @task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
<% end %>

<%= link_to "annuler", tasks_path %>
